# Settings of petrirl-deploy (copy to /etc/default/petrirl-studio)
PETRIRL_SRC=/mnt/development/09_PetriRL/PetriRL-Studio
PETRIRL_APP=/opt/petrirl-studio
PETRIRL_DATA_PATH=/opt/petrirl-studio-data
PETRIRL_PORT=5000
PETRIRL_SECRET_KEY=change-me
# public demo: no agent uploads, nothing can be deleted or changed by visitors (0 = full app for yourself)
PETRIRL_PUBLIC=1
# public address (canonical links, sitemap.xml)
PETRIRL_SITE_URL=https://petrirl.de
# who runs the site, shown on the privacy page (required by German law): a postal address where letters reach you
PETRIRL_OPERATOR_NAME="Sofiene Lassoued"
PETRIRL_OPERATOR_ADDRESS="Musterstraße 1, 12345 Musterstadt"
PETRIRL_OPERATOR_EMAIL="you@example.org"
